{
  "name": "@abstractframework/assistant",
  "version": "0.1.0",
  "description": "AbstractAssistant for the web: chat or talk with the Assistant in a browser, with live answers, approvals, dictation and read aloud. A thin client of AbstractGateway, served at /apps/assistant-web/.",
  "keywords": [
    "abstractframework",
    "assistant",
    "chat",
    "voice",
    "gateway",
    "ui"
  ],
  "homepage": "https://github.com/lpalbou/AbstractAssistant/tree/main/web#readme",
  "bugs": {
    "url": "https://github.com/lpalbou/AbstractAssistant/issues"
  },
  "type": "module",
  "author": "Laurent-Philippe Albou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpalbou/AbstractAssistant.git",
    "directory": "web"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "abstractassistant-web": "bin/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port 3008",
    "build": "node scripts/sync_conversation.mjs --check && node scripts/sync_sessions.mjs --check && node scripts/sync_gateway_voice.mjs --check && node scripts/sync_apple_avatars.mjs --check && node scripts/sync_docs_assistant.mjs --check && tsc && vite build && node scripts/build_docs_corpus.mjs && node scripts/check_relative_urls.mjs --dist",
    "check:urls": "node scripts/check_relative_urls.mjs",
    "start": "node ./bin/cli.js",
    "test": "vitest run",
    "test:layout": "node scripts/check_layout.mjs",
    "test:experience": "node scripts/check_experience.mjs",
    "sync:avatars": "node scripts/sync_apple_avatars.mjs",
    "sync:docs": "node scripts/sync_docs_assistant.mjs",
    "sync:voice": "node scripts/sync_gateway_voice.mjs",
    "sync:sessions": "node scripts/sync_sessions.mjs",
    "sync:conversation": "node scripts/sync_conversation.mjs",
    "check:package": "node scripts/check_package.mjs",
    "prepublishOnly": "npm run build && node scripts/check_package.mjs"
  },
  "dependencies": {
    "@abstractframework/app-server": "^0.1.13"
  },
  "devDependencies": {
    "@abstractframework/panel-chat": "^0.8.1",
    "@abstractframework/ui-kit": "^0.9.14",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "5.0.4"
  }
}
